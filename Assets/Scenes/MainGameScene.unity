  m_Script: {fileID: 11500000, guid: f5098889b57482f49b15c41cd1cfb1d0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialManager
  tutorialEnabled: 1
  rememberAcrossSessions: 0
  overlayRoot: {fileID: 1407459043}
  messageText: {fileID: 958419717}
  speakerNameText: {fileID: 421174655}
  speakerPortrait: {fileID: 991300174}
  continueHint: {fileID: 834365329}
  charactersPerSecond: 60
  narratorOverride: {fileID: 11400000, guid: 8f9fcad24b905314ea204f55636d686c, type: 2}
  fallbackNarratorName: Elin
  fallbackNarratorPortrait: {fileID: 2800000, guid: ab842ed2e5c35274486a14d1f40768fb, type: 3}
  messages:
  - id: intro
    trigger: 0
    text: Hello, can you hear me? It's me, {narrator}! Our team has arrived at the
      first ritual location! To start the turn, choose one of the heroines.
    showOnce: 1
  - id: actions
    trigger: 1
    text: 'Good! Now you can choose between four actions. Hover over each one to
      learn more about it, but in short: Arcana attacks a ghost, Warding keeps you
      alive, Lore helps you understand the ghosts, and Occultism progresses the ritual.'
    showOnce: 1
  - id: objective
    trigger: 2
    text: 'Your objective is to finish the ritual! No heroics needed: just stay alive
      and healthy, and finish the ritual!'
    showOnce: 1
  - id: channel_adjacent
    trigger: 3
    text: Good thinking, {heroine}, but you can only progress the ritual if you're
      standing beside the Anchor!
    showOnce: 1
  - id: channel_stability
    trigger: 4
    text: Good thinking, {heroine}, but the Anchor's current Stability can't hold
      this much occult energy. You should cast a ward on the Anchor as well.
    showOnce: 1
  - id: downed
    trigger: 5
    text: Watch out, {heroine} is down! Send someone beside her and patch her up
      with Warding!
    showOnce: 1
